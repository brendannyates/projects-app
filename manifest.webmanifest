    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New task", "url": "./?new=task", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Timeline", "url": "./?view=timeline", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
